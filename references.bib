@article{clarkQuotationsDemonstrations1990,
  title = {Quotations as {{Demonstrations}}},
  author = {Clark, Herbert H. and Gerrig, Richard J.},
  date = {1990-12},
  journaltitle = {Language},
  volume = {66},
  number = {4},
  pages = {764--805},
  issn = {0097-8507, 1535-0665},
